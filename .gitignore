# ---- Android / Gradle 构建产物 ----
.gradle/
build/
app/build/
local.properties
captures/

# ---- IDE ----
*.iml
.idea/
*.swp
*.ipr
*.iws

# ---- OS / 杂项 ----
.DS_Store
Thumbs.db
*.log
*.tmp

# ---- 打包产物（CI 通过 artifact 分发，不入库）----
*.apk
*.aar
*.jar
# 但 Gradle Wrapper 的 jar 必须入库，否则 CI 上 ./gradlew 无法运行
!gradle/wrapper/gradle-wrapper.jar

# 注意：debug.keystore 必须入库（CI 与本地共用同一把签名，
# 否则新包签名不同、无法覆盖安装）。不要把它加进忽略。
